# Required: JWT signing secret.
# Use a unique random value of at least 32 characters per environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: YooKassa credentials.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional: frontend URL for payment return.
YOOKASSA_RETURN_URL=http://localhost:3000/payment-return

# First administrator on a clean database. Set both for initial startup only.
# Do not commit real credentials.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
